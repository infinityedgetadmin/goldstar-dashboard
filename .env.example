# Firebase Configuration
# Get these values from https://console.firebase.google.com/
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# App Check (guest surface) — required outside emulator use, see src/lib/public/env.ts
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_KEY=your_recaptcha_enterprise_key_here

# Set to "1" for local development against the goldstar-platform Firebase emulators
NEXT_PUBLIC_USE_EMULATORS=

# Live ops map (URL-restricted Mapbox public token — see https://account.mapbox.com/access-tokens/).
# Unset shows an honest "map unavailable" state on /live instead of venue pins/driver locations;
# mapbox-gl itself is only ever loaded once this is set (see src/features/live/live-board.tsx).
NEXT_PUBLIC_MAPBOX_PUBLIC_TOKEN=

# NOTE: Auth (Clerk) is not wired up yet — this is Task 2+'s scope
# (src/providers/providers.tsx has a marked mount point for it).
